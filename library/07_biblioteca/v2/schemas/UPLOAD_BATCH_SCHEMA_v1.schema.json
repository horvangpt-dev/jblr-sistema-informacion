{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://jblr.local/schemas/UPLOAD_BATCH_SCHEMA_v1.schema.json","title":"JBLR 07.V2 Upload Batch v1","type":"object","additionalProperties":false,"required":["UPLOAD_BATCH_ID","MODULE_ID","ORIGIN_ACTOR","FILES"],"properties":{"UPLOAD_BATCH_ID":{"type":"string","pattern":"^JBLR-UPLOAD-001-[0-9]{8}-[0-9]{4}$"},"MODULE_ID":{"type":"string","pattern":"^JBLR-MOD-[0-9]{4}$"},"ORIGIN_ACTOR":{"const":"001"},"FILES":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["SOURCE_URL","SOURCE_INSTITUTION","ORIGINAL_FILENAME","LANGUAGE","DISCOVERED_AT","DOWNLOADED_AT","SEARCH_CONTEXT","NOTES"],"properties":{"SOURCE_URL":{"oneOf":[{"type":"string","format":"uri"},{"enum":["UNKNOWN","NOT_ASSESSED","NOT_APPLICABLE"]}]},"SOURCE_INSTITUTION":{"type":"string","minLength":1},"ORIGINAL_FILENAME":{"type":"string","minLength":1},"LANGUAGE":{"type":"string","minLength":1},"DISCOVERED_AT":{"type":"string","minLength":1},"DOWNLOADED_AT":{"type":"string","minLength":1},"SEARCH_CONTEXT":{"type":"string","minLength":1},"NOTES":{"type":"string"},"AUTHOR":{"type":"string"},"YEAR":{"oneOf":[{"type":"integer","minimum":1000,"maximum":2200},{"enum":["UNKNOWN","NOT_ASSESSED","NOT_APPLICABLE"]}]},"TITLE":{"type":"string"},"DOCUMENT_TYPE_HINT":{"type":"string"},"DOWNLOAD_STATUS":{"enum":["DOWNLOADED","NOT_DOWNLOADED"]}}}}}}