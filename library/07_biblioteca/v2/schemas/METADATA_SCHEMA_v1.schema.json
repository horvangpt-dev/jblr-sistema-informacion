{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jblr.local/schemas/library/METADATA_SCHEMA_v1.schema.json",
  "title": "JBLR 07.V2 Library Metadata Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "LIB_FILE_ID",
    "SOURCE_ID",
    "SOURCE_FAMILY_ID",
    "ORIGINAL_FILENAME",
    "FORMAT",
    "DRIVE_ID",
    "CANONICAL_FILE_LOCATION",
    "VERSION",
    "field_states",
    "CONTENT_INDEX_STATUS",
    "FULLTEXT_STATUS",
    "OCR_STATUS",
    "PAGE_INDEX_STATUS",
    "EXTRACTION_STATUS",
    "QA_STATUS",
    "INGESTED_AT"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "LIB_FILE_ID": {"type": "string", "pattern": "^JBLR-LIB-[0-9]{6}$"},
    "SOURCE_ID": {"type": "string", "pattern": "^JBLR-SRC-[0-9]{6}$"},
    "SOURCE_FAMILY_ID": {"type": "string", "pattern": "^JBLR-SFAM-[0-9]{6}$"},
    "legacy_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "ORIGINAL_FILENAME": {"type": "string", "minLength": 1},
    "TITLE": {"type": "string"},
    "DOCUMENT_TYPE": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/DOCUMENT_TYPE"},
    "FORMAT": {"type": "string", "minLength": 1},
    "PRIMARY_LANGUAGE": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/LANGUAGE"},
    "SECONDARY_LANGUAGES": {"type": "array", "items": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/LANGUAGE"}, "uniqueItems": true},
    "INSTITUTION": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "AUTHORS": {"type": "array", "items": {"type": "string"}},
    "COUNTRY": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "YEAR": {"type": "integer", "minimum": 0, "maximum": 3000},
    "JBLR_AREA": {"type": "array", "items": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/JBLR_AREA"}, "uniqueItems": true},
    "PROCESS": {"type": "array", "items": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/PROCESS"}, "uniqueItems": true},
    "SUBPROCESS": {"type": "array", "items": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/SUBPROCESS"}, "uniqueItems": true},
    "TOPICS": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "OBJECT_TYPE": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "SOURCE_CLASS": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/SOURCE_CLASS"},
    "PRIMARY_OR_SECONDARY": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/PRIMARY_OR_SECONDARY"},
    "TECHNICAL_LEVEL": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/TECHNICAL_LEVEL"},
    "DRIVE_ID": {"type": "string", "minLength": 1},
    "CANONICAL_FILE_LOCATION": {"type": "string", "minLength": 1},
    "ORIGINAL_URL": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provenance_occurrences": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["location_type", "pointer"], "properties": {"location_type": {"enum": ["drive", "url", "repository", "physical", "other"]}, "pointer": {"type": "string"}, "observed_at": {"type": "string", "format": "date-time"}, "notes": {"type": "string"}}}},
    "HASH": {"type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}},
    "FILE_SIZE": {"type": "integer", "minimum": 0},
    "VERSION": {"type": "string", "minLength": 1},
    "SUPERSEDES": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "SUPERSEDED_BY": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "DUPLICATE_OF": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "PARENT_DOCUMENT": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "RELATED_FILES": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "CONTENT_INDEX_STATUS": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/CONTENT_INDEX_STATUS"},
    "FULLTEXT_STATUS": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/FULLTEXT_STATUS"},
    "OCR_STATUS": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/OCR_STATUS"},
    "PAGE_INDEX_STATUS": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/PAGE_INDEX_STATUS"},
    "EXTRACTION_STATUS": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/EXTRACTION_STATUS"},
    "QA_STATUS": {"$ref": "../vocabularies/CONTROLLED_VOCABULARIES_v1.json#/$defs/QA_STATUS"},
    "RIGHTS": {"type": "string"},
    "LICENSE": {"type": "string"},
    "ACCESS_RESTRICTIONS": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "INGESTED_AT": {"type": "string", "format": "date-time"},
    "CHECKED_AT": {"type": "string", "format": "date-time"},
    "NOTES": {"type": "string"},
    "field_states": {"type": "object", "description": "Explicit epistemic state for fields where missingness matters. A missing value must not be interpreted as absence. If a field was evaluated but has no known value, record one of UNKNOWN, NOT_ASSESSED, NOT_APPLICABLE, NOT_FOUND.", "additionalProperties": {"enum": ["KNOWN", "UNKNOWN", "NOT_ASSESSED", "NOT_APPLICABLE", "NOT_FOUND"]}}
  }
}