# Server-side only. Never expose these variables in browser JavaScript.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PORT=3000

# JBLR Autonomous Actor Runtime
# Put the real key in the deployment secret store. Never commit it.
OPENAI_API_KEY=
JBLR_AGENT_MODEL=gpt-5.6
JBLR_AGENT_RUNTIME_PORT=8790
JBLR_RUNTIME_STATE_DIR=.runtime-state

# Operational thresholds: absolute SDK-reported input tokens/items, not percentages.
# Tune per selected model/deployment after observing real runs.
JBLR_CONTEXT_COMPACTION_ITEMS=100
JBLR_CONTEXT_ELEVATED_ITEMS=120
JBLR_CONTEXT_HIGH_ITEMS=180
JBLR_CONTEXT_ELEVATED_INPUT_TOKENS=60000
JBLR_CONTEXT_HIGH_INPUT_TOKENS=90000
