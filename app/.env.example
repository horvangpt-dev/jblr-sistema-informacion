# Server-side only. Never expose these variables in browser JavaScript.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PORT=3000

# JBLR Autonomous Actor Runtime
# Put the real key in the deployment secret store. Never commit it.
OPENAI_API_KEY=
JBLR_AGENT_MODEL=gpt-5.6
JBLR_AGENT_RUNTIME_PORT=8790
JBLR_RUNTIME_STATE_DIR=.runtime-state

# Shared JBLR state. The service-account JSON belongs in the deployment secret store.
# Share only the required JBLR spreadsheets/folders with that service account.
GOOGLE_SERVICE_ACCOUNT_JSON=
JBLR_EVENT_BUS_SPREADSHEET_ID=1ooGUwDYQ5Q_nR6ctvrMx1kS1ESaJVmNDsyizLeXRMNs
JBLR_CANONICAL_STATE_SPREADSHEET_ID=1UhIkAmCNLVJibUUhbAogyU8EtzUsNOsIqdkEdfS_KMo
# JSON map actor -> parent continuity folder, e.g. {"0000":"<folder-id>","04":"<folder-id>"}
JBLR_CONTINUITY_FOLDER_MAP={}

# GitHub runtime verification is intentionally read-only.
JBLR_GITHUB_REPO=horvangpt-dev/jblr-sistema-informacion
JBLR_GITHUB_READ_TOKEN=

# Operational thresholds: absolute SDK-reported input tokens/items, not percentages.
# Tune per selected model/deployment after observing real runs.
JBLR_CONTEXT_COMPACTION_ITEMS=100
JBLR_CONTEXT_ELEVATED_ITEMS=120
JBLR_CONTEXT_HIGH_ITEMS=180
JBLR_CONTEXT_ELEVATED_INPUT_TOKENS=60000
JBLR_CONTEXT_HIGH_INPUT_TOKENS=90000
